{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "windBlick visualization request parameters — draft v0.1",
  "description": "Draft for A2/A3 review. Validates only the JSON parameters part; see api-contract.md for multipart and cross-field requirements. ReferencePointFuture is reserved and not active in v0.1.",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "0.1"
    },
    "image": {
      "$ref": "#/$defs/Image"
    },
    "camera": {
      "$ref": "#/$defs/Camera"
    },
    "turbines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/Turbine"
      }
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "pattern": "^/"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Provenance"
      },
      "maxProperties": 256
    },
    "reference_points": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "$ref": "#/$defs/ReferencePointFuture"
      }
    }
  },
  "required": [
    "api_version",
    "image",
    "camera",
    "turbines"
  ],
  "additionalProperties": false,
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Elevation": {
      "type": "object",
      "properties": {
        "value_m": {
          "type": "number"
        },
        "datum": {
          "const": "DHHN2016_NHN"
        },
        "source": {
          "enum": [
            "survey",
            "user_input",
            "fixture",
            "backend_model"
          ]
        },
        "uncertainty_m": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "value_m",
        "datum",
        "source"
      ],
      "additionalProperties": false
    },
    "Coordinates": {
      "type": "object",
      "properties": {
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      "required": [
        "longitude_deg",
        "latitude_deg"
      ],
      "additionalProperties": false
    },
    "Position": {
      "type": "object",
      "properties": {
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "elevation": {
          "$ref": "#/$defs/Elevation"
        }
      },
      "required": [
        "longitude_deg",
        "latitude_deg",
        "elevation"
      ],
      "additionalProperties": false
    },
    "Orientation": {
      "type": "object",
      "properties": {
        "heading_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "pitch_deg": {
          "type": "number",
          "exclusiveMinimum": -90,
          "exclusiveMaximum": 90
        },
        "roll_deg": {
          "type": "number",
          "minimum": -180,
          "exclusiveMaximum": 180
        },
        "north_reference": {
          "const": "true"
        }
      },
      "required": [
        "heading_deg",
        "pitch_deg",
        "roll_deg",
        "north_reference"
      ],
      "additionalProperties": false
    },
    "PixelPoint": {
      "type": "object",
      "properties": {
        "x_px": {
          "type": "number",
          "minimum": 0
        },
        "y_px": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x_px",
        "y_px"
      ],
      "additionalProperties": false
    },
    "Intrinsics": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "horizontal_fov"
            },
            "horizontal_fov_deg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 180
            }
          },
          "required": [
            "kind",
            "horizontal_fov_deg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "physical_focal_length"
            },
            "focal_length_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sensor_width_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sensor_height_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "focal_length_mm",
            "sensor_width_mm",
            "sensor_height_mm"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "calibrated"
            },
            "fx_px": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fy_px": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cx_px": {
              "type": "number",
              "minimum": 0
            },
            "cy_px": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "fx_px",
            "fy_px",
            "cx_px",
            "cy_px"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Image": {
      "type": "object",
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "orientation": {
          "const": "normalized"
        },
        "captured_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "width_px",
        "height_px",
        "orientation"
      ],
      "additionalProperties": false
    },
    "Camera": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/Position"
        },
        "orientation": {
          "$ref": "#/$defs/Orientation"
        },
        "intrinsics": {
          "$ref": "#/$defs/Intrinsics"
        }
      },
      "required": [
        "position",
        "orientation",
        "intrinsics"
      ],
      "additionalProperties": false
    },
    "TurbineStatus": {
      "type": "string",
      "enum": [
        "operating",
        "approved"
      ]
    },
    "TurbineSource": {
      "type": "object",
      "properties": {
        "dataset": {
          "const": "nrw_renewable_energies_wfs"
        },
        "feature_type": {
          "type": "string",
          "enum": [
            "erneuerbare_energien_wfs:Windenergieinbetrieb",
            "erneuerbare_energien_wfs:Windenergiegehnemigt"
          ]
        },
        "feature_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retrieved_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "data_as_of": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "raw_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "unit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "dataset",
        "feature_type",
        "feature_id",
        "retrieved_at",
        "raw_status"
      ],
      "additionalProperties": false
    },
    "Turbine": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "hub_height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotor_diameter_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "turbine_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "$ref": "#/$defs/TurbineStatus"
        },
        "source": {
          "$ref": "#/$defs/TurbineSource"
        }
      },
      "required": [
        "id",
        "position",
        "hub_height_m",
        "rotor_diameter_m",
        "status",
        "source"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "properties": {
                  "feature_type": {
                    "const": "erneuerbare_energien_wfs:Windenergieinbetrieb"
                  }
                },
                "required": [
                  "feature_type"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "operating"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "properties": {
                  "feature_type": {
                    "const": "erneuerbare_energien_wfs:Windenergiegehnemigt"
                  }
                },
                "required": [
                  "feature_type"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          }
        }
      ]
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "exif",
            "device_sensor",
            "user_input",
            "wfs",
            "fixture",
            "derived"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "ReferencePointFuture": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "image_point": {
          "$ref": "#/$defs/PixelPoint"
        },
        "map_position": {
          "$ref": "#/$defs/Coordinates"
        },
        "map_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "map_date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "image_point",
        "map_position"
      ],
      "additionalProperties": false
    }
  }
}
