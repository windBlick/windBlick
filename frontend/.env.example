# Copy to .env.local and adjust.

# true  = browser-side mock of POST /api/v0/visualizations (no backend needed)
# false = call the real backend
VITE_USE_MOCKS=true

# Dev server only: where Vite forwards /api requests (FastAPI default port)
VITE_BACKEND_URL=http://localhost:8000

# Only if the frontend is served from a different origin than the API
# (requires CORS on the backend). Leave empty to use same-origin /api.
VITE_API_BASE_URL=
